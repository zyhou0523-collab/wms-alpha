# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=wms_alpha
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# Spring datasource override
WMS_DB_URL=jdbc:mysql://localhost:3306/wms_alpha?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
WMS_DB_USER=root
WMS_DB_PASSWORD=123456

# Frontend
# Local Vite proxy: /api
# Deployed frontend example: http://localhost:8080/api
VITE_API_BASE_URL=/api
VITE_USE_MOCK=false
